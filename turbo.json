{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "NODE_ENV",
        "PORT",
        "WEB_PORT",
        "DATABASE_URL",
        "APP_SECRET",
        "ADMIN_PIN",
        "WEB_ORIGIN",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_SITE_URL",
        "OPENAI_API_KEY",
        "OPENAI_MODEL",
        "OPENAI_REALTIME_MODEL",
        "OPENAI_REALTIME_VOICE",
        "POS_PROVIDER",
        "POS_WEBHOOK_URL",
        "POS_WEBHOOK_TOKEN",
        "CORNPOS_API_URL",
        "CORNPOS_API_KEY",
        "CORNPOS_BRANCH_MAP",
        "FOODICS_API_TOKEN",
        "FOODICS_BRANCH_ID",
        "FORCE_OPEN",
        "TAX_RATE_COD",
        "TAX_RATE_CARD"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "generate": {
      "cache": false
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "env": [
        "DATABASE_URL",
        "TEST_DATABASE_URL"
      ]
    }
  }
}
