{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "DATABASE_URL",
        "APP_SECRET",
        "ADMIN_PASSWORD",
        "WEB_ORIGIN",
        "NEXT_PUBLIC_API_URL",
        "POS_PROVIDER",
        "POS_WEBHOOK_URL",
        "POS_WEBHOOK_TOKEN",
        "OPENAI_API_KEY",
        "PORT"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "generate": {
      "cache": false
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "env": [
        "DATABASE_URL",
        "TEST_DATABASE_URL"
      ]
    }
  }
}
