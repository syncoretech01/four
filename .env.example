# ── Core ───────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:four@localhost:5432/four
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_SECRET=change-me-32-random-chars-minimum
# kitchen console sign-in, entered on a tablet numpad: 4-8 digits
ADMIN_PIN=change-me

# ── AI assistant (OpenAI). Without a key the deterministic
#    parser still takes full orders; voice needs the key. ────
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_REALTIME_MODEL=gpt-realtime
# OPENAI_REALTIME_VOICE=marin

# ── POS bridge: console (default) | cornpos | demo | webhook | foodics
#    The confirmed till system is Corn POS; switch to cornpos once their
#    team issues credentials - see docs/POS-INTEGRATION.md ──
POS_PROVIDER=console
# CORNPOS_API_URL=   # order-intake endpoint from Corn POS support
# CORNPOS_API_KEY=
# CORNPOS_BRANCH_MAP=fairways-dha6:101,allama-iqbal-town:102,lake-city:103
# POS_WEBHOOK_URL=https://example.com/orders-inbox
# POS_WEBHOOK_TOKEN=

# ── Online card payments: none (default, card machine at the door) |
#    demo (built-in gateway page, proves the full rail) |
#    safepay | payfast (real gateways - need FOUR's merchant account) ──
PAYMENT_PROVIDER=none
# SAFEPAY_API_KEY=
# SAFEPAY_SECRET=
# PAYFAST_MERCHANT_ID=
# PAYFAST_SECURED_KEY=

# ── Customer messaging (order updates + sign-in codes):
#    console (default, logs) | webhook (any bridge) | whatsapp (Meta Graph API) ──
NOTIFY_PROVIDER=console
# NOTIFY_WEBHOOK_URL=
# NOTIFY_WEBHOOK_TOKEN=
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=

# ── Tax (menu prices are exclusive of tax) ─────────────────
# TAX_RATE_COD=0.16
# TAX_RATE_CARD=0.08
