# ── POS bridge ─────────────────────────────────────────────
# console (default) | webhook | foodics   - see docs/POS-INTEGRATION.md
POS_PROVIDER=console
# POS_WEBHOOK_URL=https://example.com/orders-inbox
# POS_WEBHOOK_TOKEN=

# Foodics (when confirmed as the live POS)
# FOODICS_API_TOKEN=
# FOODICS_BRANCH_ID=

# ── Optional LLM upgrade for the assistant ─────────────────
# The chat/voice assistant is fully functional without any key
# (deterministic parser). Set a key to layer Claude on top later.
# ANTHROPIC_API_KEY=
