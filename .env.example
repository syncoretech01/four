# ── Core ───────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:four@localhost:5432/four
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
APP_SECRET=change-me-32-random-chars-minimum
# kitchen console sign-in, entered on a tablet numpad: 4-8 digits
ADMIN_PIN=change-me

# ── AI assistant (OpenAI). Without a key the deterministic
#    parser still takes full orders; voice needs the key. ────
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_REALTIME_MODEL=gpt-realtime
# OPENAI_REALTIME_VOICE=marin

# ── POS bridge: console (default) | webhook | foodics ──────
POS_PROVIDER=console
# POS_WEBHOOK_URL=https://example.com/orders-inbox
# POS_WEBHOOK_TOKEN=

# ── Tax (menu prices are exclusive of tax) ─────────────────
# TAX_RATE_COD=0.16
# TAX_RATE_CARD=0.08
